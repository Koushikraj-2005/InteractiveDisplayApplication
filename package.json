{
  "name": "naveen-farms",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:staff": "vite build --config staff-app/vite.config.js",
    "build:all": "npm run build && npm run build:staff",
    "preview": "vite preview",
    "verify": "npm run build && vite preview",
    "server": "node server/index.mjs",
    "start": "node server/index.mjs",
    "dev:all": "concurrently -k -n API,WEB,STAFF -c green,blue,magenta \"node server/index.mjs\" \"vite\" \"vite --config staff-app/vite.config.js\"",
    "tts:download": "node scripts/download-tts.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/cli": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^10.0.5",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "vite": "^5.4.11"
  }
}
